# Copy to .env.local and fill in. .env.local is gitignored.

# --- Database -----------------------------------------------------------
# Neon pooled connection string. Create a project at https://neon.tech, then
# Dashboard -> Connection Details -> "Pooled connection".
# Use a Neon *branch* while iterating on seed, so a bad seed never touches main.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ------------------------------------------------------------
# Generate with: pnpm dlx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Guest link: a shareable sign-in link for people who do not connect GitHub
# (e.g. 904 Advisory). Anyone with https://<your-site>/join/<GUEST_LINK_TOKEN>
# can sign in, no password. Use a long random value:  openssl rand -hex 24
# Leave empty to disable; change it to revoke every link shared so far.
# Everyone using the link shares one account (and its progress), and every
# node is unlocked for it (lib/guest.ts). Do not add
# guest@mlroadmap to ADMIN_EMAILS.
GUEST_LINK_TOKEN=""

# Google is not wired up. To add it back: add the provider to lib/auth.ts,
# register a client at https://console.cloud.google.com/apis/credentials with
# redirect URI http://localhost:3000/api/auth/callback/google, and set
# AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET here.

# --- Admin -------------------------------------------------------------
# Comma-separated emails that can reach /admin. Deliberately an env var and
# not a database column: there is no code path in the app that can grant
# admin, so no bug can escalate a learner into one. Empty means nobody.
ADMIN_EMAILS="you@example.com"

# Required on Vercel; leave unset locally.
# AUTH_URL="https://your-app.vercel.app"
